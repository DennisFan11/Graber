[sub_resource type="Shader" id="Shader_2sn7p"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

// 硬漸層層數
uniform int layer_count : hint_range(2, 32, 1) = 4;

// SDF 深度，越大代表漸層往內吃越深
uniform float sdf_depth : hint_range(1.0, 512.0, 1.0) = 50.0;

void fragment() {
    vec2 sdfuv = screen_uv_to_sdf(SCREEN_UV);
    float dist = texture_sdf(sdfuv);

    // dist 內部是負數，所以用 -dist
    // dist = 0        → t = 0
    // dist = -depth   → t = 1
    float t = clamp(-dist / sdf_depth, 0.0, 1.0);

    // 多層硬漸層
    float layers = float(layer_count - 1);
    float alpha = floor(t * layers) / layers;

    vec4 screen_col = texture(SCREEN_TEXTURE, SCREEN_UV);

    COLOR = mix(screen_col, COLOR, alpha);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_n5qc6"]
shader = SubResource("Shader_2sn7p")
shader_parameter/layer_count = 4
shader_parameter/sdf_depth = 36.0

